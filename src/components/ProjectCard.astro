---
import { Server } from "lucide-astro";

interface Props {
  project: {
    title: string;
    description: string;
    technologies: string[];
  };
}

const { project } = Astro.props;
---

<article class="project-card">

  <div class="project-icon">
  <Server size={34} />
</div>

  <h3>{project.title}</h3>

  <p>{project.description}</p>

  <div class="tags">
    {project.technologies.map((tech) => (
      <span>{tech}</span>
    ))}
  </div>

  <a href="#" class="project-link">
    Ver detalles →
  </a>

</article>