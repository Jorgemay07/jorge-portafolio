---
import {
  Server,
  Database,
  HardDrive,
  Container,
  Network,
} from "lucide-astro";
---

<div class="infra-card">

    <h3>Infraestructura </h3>

    <div class="infra-item">
    <Server class="infra-icon" />

        <div>
            <strong>VMware ESXi</strong>
            <span>Operativo</span>
        </div>
    </div>

    <div class="infra-item">
        <Database class="infra-icon" />

        <div>
            <strong>Windows Server</strong>
            <span>12 servidores</span>
        </div>
    </div>

    <div class="infra-item">
        <HardDrive class="infra-icon" />

        <div>
            <strong>Ubuntu Linux</strong>
            <span>Healthy</span>
        </div>
    </div>

    <div class="infra-item">
        <Container class="infra-icon" />

        <div>
            <strong>Synology DSM</strong>
            <span>Running</span>
        </div>
    </div>

    <div class="infra-item">
        <Network class="infra-icon" />

        <div>
            <strong>Networking</strong>
            <span>Online</span>
        </div>
    </div>

     <div class="infra-item">
        <Network class="infra-icon" />

        <div>
            <strong>PowerShell</strong>
            <span>Online</span>
        </div>
    </div>

    <div class="availability">

        <span>Disponibilidad</span>

        <strong>99.9%</strong>

    </div>

</div>