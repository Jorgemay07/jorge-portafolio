---
import { profile } from "../data/profile";
import InfrastructureCard from "./InfraestructureCard.astro";
import { Download, Linkedin } from "lucide-astro";

---

<section class="hero" id="home">

    <div class="hero-text">

       <div class="hero-top">

    <span class="hero-badge">

        <span class="status-dot"> </span>

AVAILABLE FOR PROJECTS
    </span>


    <span class="hero-divider"></span>

    <span class="hero-intro">

    INFRASTRUCTURE • SYSTEMS • CLOUD

    </span>

</div>


        <h1>{profile.name}</h1>

        <h2>{profile.title}</h2>

        <p>{profile.description}</p>

        <div class="buttons">

           <a class="btn btn-primary">

    <Download size={20}/>

    Descargar CV

</a>

<a class="btn btn-outline">

    <Linkedin size={20}/>

    LinkedIn

</a>

        </div>

        <div class="stats">

    <div class="stat">

        <h3>11+</h3>

        <span>Años de experiencia</span>

    </div>

    <div class="stat">

        <h3>24/7</h3>

        <span>Infraestructura crítica</span>

    </div>

    <div class="stat">

        <h3>100%</h3>

        <span>Compromiso</span>

    </div>

</div>
    </div>

    <div class="hero-image">

        <InfrastructureCard />

    </div>

</section>