---
const experience = [
  {
    period: "2022 - Actualidad",
    title: "Ingeniero de Infraestructura",
    company: "COBAY",
    description:
      "Administración de infraestructura tecnológica, virtualización VMware, almacenamiento Synology, servidores Linux y Windows Server."
  },
  {
    period: "Experiencia previa",
    title: "Administrador de Sistemas",
    company: "Por completar",
    description:
      "Aquí agregaremos tus empleos anteriores cuando revisemos tu CV."
  }
];
---

<section id="experience" class="experience">

  <div class="section-header">
    <span class="section-title">EXPERIENCIA</span>
    <h2>Mi trayectoria profesional</h2>
  </div>

  <div class="timeline">

    {experience.map((job) => (

      <article class="timeline-item">

        <div class="timeline-dot"></div>

        <div class="timeline-content">

          <span class="period">{job.period}</span>

          <h3>{job.title}</h3>

          <h4>{job.company}</h4>

          <p>{job.description}</p>

        </div>

      </article>

    ))}

  </div>

</section>